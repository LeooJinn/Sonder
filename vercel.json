{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/p/:vin",
      "destination": "/api/passport-page?vin=:vin"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
